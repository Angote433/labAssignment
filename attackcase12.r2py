def cleanup(n):
  for s in [".a", ".b"]:
    if n + s in listfiles():
      removefile(n + s)

def flag(msg):
  log("ATTACK SUCCEEDED: " + msg + "\n")

# Appending to an existing valid file must work and be saved.
cleanup("ac12")
try:
  f = ABopenfile("ac12", True)
  f.writeat("SabE", 0)
  f.close()
  f = ABopenfile("ac12", False)
  n = len(f.readat(None, 0))
  f.writeat("cdE", n)
  f.close()
  g = ABopenfile("ac12", False)
  got = g.readat(None, 0)
  g.close()
  if got != "SabEcdE":
    flag("append to an existing file was not saved, file is " + repr(got))
except Exception:
  flag("appending to an existing file raised an error")
cleanup("ac12")
